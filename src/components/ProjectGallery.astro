---
import { Icon } from 'astro-icon/components';
import type { Project } from '@/types/projects';

interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3';
  editorial?: boolean;
}

const { projects, headingLevel = 'h3', editorial = false } = Astro.props;
const Heading = headingLevel;
const imagePath = (image: string) => `/img/projects/${image.includes('.') ? image : `${image}.webp`}`;
---

<div class:list={['grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-20', { 'editorial-gallery': editorial }]}>
  {projects.map((project, index) => {
    const primaryUrl = project.url || project.githubUrl;
    return (
      <article class="project-item group" data-reveal style={`--reveal-delay: ${(index % 3) * 90}ms`}>
        <a href={primaryUrl || undefined} target={primaryUrl ? '_blank' : undefined} rel={primaryUrl ? 'noreferrer' : undefined} class:list={['block overflow-hidden bg-neutral-100 dark:bg-neutral-900', !primaryUrl && 'pointer-events-none']} tabindex={primaryUrl ? undefined : -1}>
          <div class="aspect-[16/9] overflow-hidden">
            <img src={imagePath(project.image)} alt={`${project.name} project screenshot`} width="800" height="450" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.035]" />
          </div>
        </a>

        <div class="mt-6 border-t border-neutral-300 pt-5 dark:border-neutral-700">
          <div class="flex items-baseline justify-between gap-4">
            <div class="flex items-baseline gap-4">
              <Heading class="text-lg font-semibold tracking-tight text-neutral-950 dark:text-white sm:text-xl">{project.name}</Heading>
            </div>
            {primaryUrl && (
              <a href={primaryUrl} target="_blank" rel="noreferrer" aria-label={`Open ${project.name}`} class="text-neutral-400 transition-colors hover:text-neutral-950 dark:text-neutral-500 dark:hover:text-white">
                <Icon name="heroicons:arrow-up-right" class="h-5 w-5" />
              </a>
            )}
          </div>
          <p class="mt-4 max-w-xl leading-relaxed text-neutral-600 dark:text-neutral-400">{project.description}</p>
          <div class="mt-5 flex items-end justify-between gap-4">
            <p class="font-mono text-xs leading-5 text-neutral-500 dark:text-neutral-400">{project.technologies.join(' · ')}</p>
            {project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noreferrer" aria-label={`${project.name} source code on GitHub`} class="shrink-0 text-neutral-400 transition-colors hover:text-neutral-950 dark:text-neutral-500 dark:hover:text-white">
                <Icon name="mdi:github" class="h-5 w-5" />
              </a>
            )}
          </div>
        </div>
      </article>
    );
  })}
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item[data-reveal]');

  if (reduceMotion) {
    projectItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const projectObserver = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.08 });

    projectItems.forEach((item) => projectObserver.observe(item));
  }
</script>

<style>
  .project-item { min-width: 0; }
  .project-item h2, .project-item h3 { font-weight: 400; letter-spacing: -.025em; }
  .project-item > a { border-radius: 6px; }
  .project-item > div a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; color: var(--folio-muted); }
  .project-item > div a:hover { color: var(--folio-ink); }
</style>
