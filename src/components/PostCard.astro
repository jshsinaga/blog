---
import { Image } from 'astro:assets';
import { formatDate, tagSlug } from '@/utils/helper';
import { postImage } from '@/utils/postImages';

interface Props {
  href: string;
  title: string;
  date: Date | string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
}

const { href, title, date, description, image, alt, tags } = Astro.props;
const optimizedImage = postImage(image);
---

<article class="journal-card group">
  <div class="journal-card-grid">
    <a href={href} aria-label={title} class="journal-card-image">
      {optimizedImage ? (
        <Image
          src={optimizedImage}
          alt={alt}
          width={300}
          height={160}
          widths={[300, 600, 900]}
          sizes="(max-width: 768px) 100vw, 300px"
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={image}
          alt={alt}
          width="300"
          height="160"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )}
    </a>

    <div class="journal-card-copy">
      <div>
        <a href={href} class="block">
          <h2 class="text-xl sm:text-2xl font-normal text-black dark:text-neutral-100 group-hover:text-neutral-600 dark:group-hover:text-neutral-400 leading-tight">
            {title}
          </h2>
        </a>
        <p class="mt-3 line-clamp-2 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-500 dark:group-hover:text-neutral-400">
          {description}
        </p>

        <div class="mt-3 flex items-center gap-1 flex-wrap">
          {tags.slice(0, 3).map((tag) => (
            <a
              href={`/tags/${tagSlug(tag)}`}
              class="rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors hover:bg-neutral-300 dark:hover:bg-neutral-700"
            >
              <span class="block px-2 py-1 text-xs font-medium">{tag}</span>
            </a>
          ))}
          {tags.length > 3 && <span class="text-xs text-neutral-500 dark:text-neutral-400">+{tags.length - 3} more</span>}
        </div>
      </div>

      <div class="flex flex-row justify-between items-center pt-2 max-md:mt-4">
        <a href={href} class="text-black dark:text-neutral-100 group-hover:underline text-sm sm:text-base font-medium">Read More</a>
        <time class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm" datetime={new Date(date).toISOString()}>
          {formatDate(date)}
        </time>
      </div>
    </div>
  </div>
</article>

<style>
  .journal-card { border-top: 1px solid var(--folio-line); padding-block: 28px; }
  .journal-card-grid { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 32px; }
  .journal-card-image { display: block; overflow: hidden; aspect-ratio: 16 / 10; border-radius: 6px; background: var(--folio-line); }
  .journal-card-image img { transition: transform 250ms ease-out; }
  .journal-card-image:hover img { transform: scale(1.025); }
  .journal-card-copy { display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }
  .journal-card-copy h2 { letter-spacing: -.025em; line-height: 1.3; }
  .journal-card-copy p { line-height: 1.6; color: var(--folio-muted); }
  .journal-card-copy time { font-size: 12px; font-variant-numeric: tabular-nums; }
  .journal-card-copy a { text-underline-offset: 5px; }
  @media (max-width: 900px) { .journal-card-grid { grid-template-columns: 220px minmax(0, 1fr); gap: 24px; } }
  @media (max-width: 640px) { .journal-card-grid { grid-template-columns: 1fr; gap: 20px; } .journal-card-image { aspect-ratio: 16 / 9; } }
  @media (prefers-reduced-motion: reduce) { .journal-card-image img { transition: none; } .journal-card-image:hover img { transform: none; } }
</style>
