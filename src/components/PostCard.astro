---
import { Image } from 'astro:assets';
import { formatDate, tagSlug } from '@/utils/helper';
import { postImage } from '@/utils/postImages';

interface Props {
  href: string;
  title: string;
  date: Date | string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
}

const { href, title, date, description, image, alt, tags } = Astro.props;
const optimizedImage = postImage(image);
---

<article class="md:h-48 group rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900">
  <div class="grid grid-cols-1 md:grid-cols-10 gap-0 md:gap-1 min-h-[200px] md:h-40">
    <a href={href} aria-label={title} class="md:col-span-3 h-36 md:h-full block">
      {optimizedImage ? (
        <Image
          src={optimizedImage}
          alt={alt}
          width={300}
          height={160}
          widths={[300, 600, 900]}
          sizes="(max-width: 768px) 100vw, 300px"
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={image}
          alt={alt}
          width="300"
          height="160"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )}
    </a>

    <div class="md:col-span-7 p-4 sm:p-5 flex flex-col justify-between">
      <div>
        <a href={href} class="block">
          <h2 class="line-clamp-1 text-ellipsis text-lg sm:text-xl font-semibold text-black dark:text-neutral-100 group-hover:text-neutral-600 dark:group-hover:text-neutral-400 leading-tight">
            {title}
          </h2>
        </a>
        <p class="mt-1 text-ellipsis line-clamp-1 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-500 dark:group-hover:text-neutral-400">
          {description}
        </p>

        <div class="mt-3 flex items-center gap-1 flex-wrap">
          {tags.slice(0, 3).map((tag) => (
            <a
              href={`/tags/${tagSlug(tag)}`}
              class="rounded bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors hover:bg-neutral-300 dark:hover:bg-neutral-700"
            >
              <span class="block px-2 py-1 text-xs font-semibold">{tag}</span>
            </a>
          ))}
          {tags.length > 3 && <span class="text-xs text-neutral-500 dark:text-neutral-400">+{tags.length - 3} more</span>}
        </div>
      </div>

      <div class="flex flex-row justify-between items-center pt-2 max-md:mt-4">
        <a href={href} class="text-black dark:text-neutral-100 group-hover:underline text-sm sm:text-base font-medium">Read More</a>
        <time class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm" datetime={new Date(date).toISOString()}>
          {formatDate(date)}
        </time>
      </div>
    </div>
  </div>
</article>
