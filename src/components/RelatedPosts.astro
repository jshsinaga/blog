---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { formatDate, postUrl } from '@/utils/helper';

interface Props {
  posts: CollectionEntry<'blogs'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-title">
    <h2 id="related-posts-title">Related posts</h2>
    <p class="related-intro">Keep exploring these topics.</p>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={postUrl(post.id)} class="related-link">
            <div>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <Icon name="heroicons:arrow-up-right" class="h-5 w-5 shrink-0" />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-posts { margin-top: 64px; }
  h2 { font-size: 28px; font-weight: 400; letter-spacing: -.025em; line-height: 1.2; }
  .related-intro { margin-top: 12px; color: var(--folio-muted); line-height: 1.6; }
  ul { margin-top: 28px; }
  li { border-top: 1px solid var(--folio-line); }
  li:last-child { border-bottom: 1px solid var(--folio-line); }
  .related-link { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 24px; }
  .related-link > div { min-width: 0; }
  time { font-size: 12px; color: var(--folio-muted); }
  h3 { margin-top: 8px; font-size: 21px; font-weight: 400; letter-spacing: -.025em; line-height: 1.35; }
  .related-link p { margin-top: 10px; color: var(--folio-muted); font-size: 15px; line-height: 1.65; }
  .related-link:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  .related-link svg { color: var(--folio-muted); }
  @media (max-width: 640px) { .related-posts { margin-top: 48px; } .related-link { gap: 16px; } }
</style>
