---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---

<footer class="text-zinc-700 dark:text-slate-100 mt-32">
  <div class="px-6 container max-w-5xl mx-auto">
    <div class="border-t border-gray-300 dark:border-gray-800 mt-5 text-center text-sm py-6">
      <h4 class="font-semibold text-base">Joshua Palti Sinaga</h4>
      <h5>Writing bugs in both frontend and backend since 2019</h5>
      © 2020-{year} | Powered by
      <a href="https://astro.build" target="_blank" rel="nofollow" class="underline">Astro</a>
      <div class="flex place-content-center">
        <a class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-800" href="https://github.com/jo0707" target="_blank" aria-label="GitHub" rel="noreferrer">
          <Icon name="mdi:github-box" class="h-6 w-6" />
        </a>
        <a class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-800" href="https://linkedin.com/in/joshuapaltisinaga" target="_blank" aria-label="LinkedIn" rel="noreferrer">
          <Icon name="mdi:linkedin" class="h-6 w-6" />
        </a>
        <a class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-800" href="https://instagram.com/code.withjoo" target="_blank" aria-label="Instagram" rel="noreferrer">
          <Icon name="mdi:instagram" class="h-6 w-6" />
        </a>
        <a class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-800" href="https://itsjo.dev" target="_blank" aria-label="My Site" rel="noreferrer">
          <Icon name="mdi:web-box" class="h-6 w-6" />
        </a>
        <a class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-800" href="/rss.xml" target="_blank" aria-label="RSS Feed">
          <Icon name="mdi:rss-box" class="h-6 w-6" />
        </a>
      </div>
    </div>
  </div>
</footer>
