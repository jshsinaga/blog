---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
const isHomepage = Astro.url.pathname === '/';
const homeHref = isHomepage ? '#home' : '/#home';
---

<footer class="portfolio-footer">
  <a href={homeHref} class="footer-logo" aria-label="Joshua Palti Sinaga — back to top">Jo</a>
  <p class="footer-name">Joshua Palti Sinaga</p>
  <p class="footer-note">Writing bugs in both frontend and backend since 2019</p>
  <p class="footer-credit">
    © 2020-{year} <span aria-hidden="true">|</span> Powered by{' '}
    <a href="https://astro.build" target="_blank" rel="nofollow noreferrer">Astro</a>
  </p>
  <nav class="footer-links" aria-label="Social links">
    <a href="https://github.com/jo0707" target="_blank" rel="noreferrer" aria-label="GitHub">
      <Icon name="mdi:github-box" class="h-5 w-5" />
    </a>
    <a href="https://linkedin.com/in/joshuapaltisinaga" target="_blank" rel="noreferrer" aria-label="LinkedIn">
      <Icon name="mdi:linkedin" class="h-5 w-5" />
    </a>
    <a href="https://instagram.com/code.withjoo" target="_blank" rel="noreferrer" aria-label="Instagram">
      <Icon name="mdi:instagram" class="h-5 w-5" />
    </a>
    <a href="/" aria-label="Portfolio">
      <Icon name="mdi:web-box" class="h-5 w-5" />
    </a>
    <a href="/rss.xml" target="_blank" rel="noreferrer" aria-label="RSS Feed">
      <Icon name="mdi:rss-box" class="h-5 w-5" />
    </a>
  </nav>
</footer>

<style>
  .portfolio-footer {
    margin-block-start: 72px;
    padding: 24px 26px 36px;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--folio-muted);
    background: var(--folio-paper);
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 4px;
    color: var(--folio-ink);
    font-size: 25px;
    font-weight: 600;
    line-height: 1.2;
  }

  .footer-name {
    color: var(--folio-ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .footer-note {
    margin-top: 3px;
  }

  .footer-credit {
    margin-top: 3px;
  }

  .footer-credit a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 7px;
  }

  .footer-links a {
    display: inline-flex;
    padding: 6px;
    border-radius: 9999px;
    color: var(--folio-muted);
    transition: color 150ms ease, background-color 150ms ease;
  }

  .footer-links a:hover {
    color: var(--folio-ink);
    background: color-mix(in srgb, var(--folio-ink) 6%, transparent);
  }

  .portfolio-footer a:focus-visible {
    outline: 2px solid var(--folio-muted);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .portfolio-footer {
      margin-block-start: 56px;
      padding: 20px 20px 32px;
    }
  }
</style>
