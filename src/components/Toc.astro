---
import { Icon } from 'astro-icon/components';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings = [] } = Astro.props as { headings: Heading[] };
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

<aside id="toc-sidebar" class="toc-sidebar fixed top-0 right-0 w-64 h-dvh bg-neutral-50 dark:bg-neutral-950 border-l border-neutral-200 dark:border-neutral-800 translate-x-full transition-transform duration-300 ease-in-out z-[60] overflow-y-auto">
  <div class="h-full rounded-none border-0 p-4">
    <div class="flex justify-between items-center border-b border-neutral-200 dark:border-neutral-700 pb-3 mb-4">
      <h3 class="font-semibold">Table of Contents</h3>
      <button id="toc-close" type="button" class="rounded px-2 py-1 hover:bg-neutral-100 dark:hover:bg-neutral-800" aria-label="Close TOC">
        <Icon name="heroicons:x-mark" class="h-5 w-5" />
      </button>
    </div>

    {toc.length === 0 ? (
      <p class="text-sm text-neutral-500 dark:text-neutral-400">No headings found in this article.</p>
    ) : (
      <nav class="space-y-2" aria-label="Table of contents">
        {toc.map((heading) => (
          <a href={`#${heading.slug}`} data-toc-link class:list={['block h-auto py-2 text-sm text-left leading-relaxed whitespace-normal hover:underline', heading.depth === 3 && 'pl-4']}>
            {heading.text}
          </a>
        ))}
      </nav>
    )}
  </div>
</aside>

<script>
  const sidebar = document.getElementById('toc-sidebar');
  const closeButton = document.getElementById('toc-close');
  const openButton = document.getElementById('toc-open');
  const overlay = document.getElementById('toc-overlay');
  const links = Array.from(document.querySelectorAll('[data-toc-link]'));

  const setOpen = (open: boolean) => {
    sidebar?.classList.toggle('translate-x-full', !open);
    sidebar?.classList.toggle('translate-x-0', open);
    openButton?.classList.toggle('opacity-0', open);
    openButton?.classList.toggle('pointer-events-none', open);
    overlay?.classList.toggle('hidden', !open || window.innerWidth >= 1024);
  };

  closeButton?.addEventListener('click', () => setOpen(false));
  openButton?.addEventListener('click', () => setOpen(true));
  overlay?.addEventListener('click', () => setOpen(false));
  // Start closed. The sidebar only opens when the user clicks the TOC button.
  setOpen(false);

  links.forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) setOpen(false);
    });
  });

  const updateActiveHeading = () => {
    let activeId = '';
    for (const link of links) {
      const id = link.getAttribute('href')?.slice(1);
      const element = id ? document.getElementById(id) : null;
      if (id && element && element.getBoundingClientRect().top <= 110) activeId = id;
    }

    links.forEach((link) => {
      link.classList.toggle('underline', link.getAttribute('href') === `#${activeId}`);
    });
  };

  document.addEventListener('scroll', updateActiveHeading, { passive: true });
  updateActiveHeading();
</script>
