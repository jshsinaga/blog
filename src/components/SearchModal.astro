---
// Full-site search powered by Pagefind.
// The index is generated at build time (postbuild: pagefind --site dist).
// In dev mode the index does not exist yet, so a friendly hint is shown.
---

<div
  id="search-modal"
  class="fixed inset-0 z-[60] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search the site"
>
  <div id="search-overlay" class="absolute inset-0 bg-black/40"></div>
  <div class="relative mx-auto mt-20 sm:mt-28 w-[calc(100%-2rem)] max-w-xl">
    <div class="overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 shadow-2xl">
      <div class="flex items-center gap-2 border-b border-neutral-200 dark:border-neutral-700 px-4 py-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0 text-neutral-500 dark:text-neutral-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <input
          id="search-input"
          type="search"
          aria-label="Search the site"
          placeholder="Search projects and posts..."
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="w-full bg-transparent text-sm text-neutral-900 dark:text-neutral-100 outline-none placeholder:text-neutral-400 dark:placeholder:text-neutral-500"
        />
        <button id="search-close" type="button" aria-label="Close search" class="flex h-11 w-11 shrink-0 items-center justify-center rounded text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </div>
      <div id="search-results" class="max-h-96 overflow-y-auto p-2"></div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // Document-level keydown handler for the '/' shortcut and 'Escape'.
    const onDocumentKeydown = (event) => {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      const openButton = document.getElementById('search-open');
      if (!modal || !input || !openButton) return;

      if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
        input.value = '';
        openButton.focus();
        return;
      }

      if (event.key === 'Tab' && !modal.classList.contains('hidden')) {
        const focusable = Array.from(modal.querySelectorAll('input, button, a[href]'));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }

      if (event.key === '/') {
        const target = event.target;
        const tag = target?.tagName;
        const isTyping =
          tag === 'INPUT' || tag === 'TEXTAREA' || target?.isContentEditable;
        if (isTyping) return;
        event.preventDefault();
        openButton.click();
      }
    };

    document.addEventListener('keydown', onDocumentKeydown);

    const init = () => {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      const openButton = document.getElementById('search-open');
      if (!modal || !input || !results || !openButton) return;
      if (modal.dataset.bound === 'true') return;
      modal.dataset.bound = 'true';

      let pagefind = null;
      let pagefindReady = null;

      const loadPagefind = () => {
        if (pagefindReady) return pagefindReady;
        pagefindReady = (async () => {
          try {
            const PAGE_FIND_PATH = '/pagefind/pagefind.js';
            const mod = await import(/* @vite-ignore */ PAGE_FIND_PATH);
            await mod.init?.();
            pagefind = mod;
            return mod;
          } catch {
            pagefind = null;
            return null;
          }
        })();
        return pagefindReady;
      };

      const showHint = (message) => {
        results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-500 dark:text-neutral-400">${message}</p>`;
      };

      const open = async () => {
        modal.classList.remove('hidden');
        input.value = '';
        results.innerHTML = '';
        window.setTimeout(() => input.focus(), 30);
        const pf = await loadPagefind();
        if (!pf) showHint('Search is available after building the site (bun run build).');
      };

      const close = () => {
        modal.classList.add('hidden');
        input.value = '';
        results.innerHTML = '';
        openButton.focus();
      };

      document.getElementById('search-close')?.addEventListener('click', close);
      openButton.addEventListener('click', open);
      modal.addEventListener('click', (event) => {
        if (event.target === modal || event.target?.id === 'search-overlay') close();
      });
      results.addEventListener('click', (event) => {
        if (event.target.closest('a')) close();
      });

      let debounceTimer;
      input.addEventListener('input', () => {
        window.clearTimeout(debounceTimer);
        const query = input.value.trim();
        if (!query) {
          results.innerHTML = '';
          return;
        }
        debounceTimer = window.setTimeout(async () => {
          const pf = pagefind || (await loadPagefind());
          if (!pf) return;
          const search =
            (await pf.debouncedSearch?.(query)) ?? (await pf.search(query));
          if (!search) return;
          if (search.results.length === 0) {
            showHint('No results found.');
            return;
          }
          const items = await Promise.all(
            search.results.slice(0, 8).map((result) => result.data())
          );
          const escapeHtml = (value) =>
            String(value).replace(/[&<>"']/g, (char) => ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[char]);
          results.innerHTML = items
            .map((item) => {
              const title = escapeHtml(item.meta?.title || 'Untitled');
              const excerpt = item.excerpt
                ? item.excerpt
                    .replace(/<mark>/g, '<mark class="rounded bg-yellow-200/80 px-0.5 dark:bg-yellow-600/40">')
                    .replace(/<\/mark>/g, '</mark>')
                : '';
              return `<a href="${item.url}" class="block rounded-md px-3 py-2.5 hover:bg-neutral-100 dark:hover:bg-neutral-800">
                <span class="block text-sm font-semibold text-neutral-900 dark:text-neutral-100">${title}</span>
                ${excerpt ? `<span class="mt-0.5 block text-xs leading-relaxed text-neutral-600 line-clamp-2 dark:text-neutral-400">${excerpt}</span>` : ''}
              </a>`;
            })
            .join('');
        }, 150);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
