---
import { Image } from 'astro:assets';
import { formatDate, tagSlug } from '@/utils/helper';
import { postImage } from '@/utils/postImages';

interface Props {
  title: string;
  image: string;
  alt: string;
  description: string;
  date: Date | string;
  tags: string[];
}

const { title, image, alt, description, date, tags } = Astro.props;
const optimizedImage = postImage(image);
---

<header class="article-header">
  <h1 class="article-title">
    {title}
  </h1>
  <div class="mt-8">
    {optimizedImage ? (
      <Image
        src={optimizedImage}
        alt={alt}
        width={900}
        height={405}
        widths={[600, 900, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-md h-48 md:h-72 object-cover zoomable border border-black/15 dark:border-white/20"
      />
    ) : (
      <img
        src={image}
        alt={alt}
        width="900"
        height="405"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-md h-48 md:h-72 object-cover zoomable border border-black/15 dark:border-white/20"
      />
    )}
    <div class="flex flex-wrap gap-4 justify-between items-start mt-5">
      <div class="flex gap-2 flex-wrap max-w-full">
        {tags.map((tag) => (
          <a href={`/tags/${tagSlug(tag)}`}>
            <span class="inline-block text-xs bg-neutral-200 dark:bg-neutral-800 rounded px-2 py-1 font-semibold hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors duration-200">
              {tag}
            </span>
          </a>
        ))}
      </div>
      <time class="text-neutral-600 dark:text-neutral-100 text-sm" datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
    </div>
  </div>

  <div class="flex flex-col py-8">
    <p class="text-base sm:text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
      {description}
    </p>
  </div>
</header>

<style>
  .article-header { border-bottom: 1px solid var(--folio-line); margin-bottom: 40px; }
  .article-title { font-size: clamp(32px, 4vw, 52px); line-height: 1.14; font-weight: 400; letter-spacing: -.035em; color: var(--folio-ink); }
</style>
