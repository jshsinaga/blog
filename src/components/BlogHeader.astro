---
import { Image } from 'astro:assets';
import { formatDate, tagSlug } from '@/utils/helper';
import { postImage } from '@/utils/postImages';

interface Props {
  title: string;
  image: string;
  alt: string;
  description: string;
  date: Date | string;
  tags: string[];
}

const { title, image, alt, description, date, tags } = Astro.props;
const optimizedImage = postImage(image);
---

<header>
  <h1 class="text-xl sm:text-2xl dark:text-neutral-100 md:text-3xl lg:text-4xl m-3 md:m-7 font-bold text-center">
    {title}
  </h1>
  <div class="w-11/12 md:w-4/5 m-auto mt-6">
    {optimizedImage ? (
      <Image
        src={optimizedImage}
        alt={alt}
        width={900}
        height={405}
        widths={[600, 900, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded shadow-md h-48 md:h-72 object-cover zoomable border border-black/15 dark:border-white/20"
      />
    ) : (
      <img
        src={image}
        alt={alt}
        width="900"
        height="405"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded shadow-md h-48 md:h-72 object-cover zoomable border border-black/15 dark:border-white/20"
      />
    )}
    <div class="flex gap-2 place-content-between mt-2">
      <div class="flex place-content-start gap-2 flex-wrap w-1/2 md:w-5/12">
        {tags.map((tag) => (
          <a href={`/tags/${tagSlug(tag)}`}>
            <span class="text-[0.6rem] sm:text-xs bg-neutral-200 dark:bg-neutral-800 rounded px-2 py-1 font-semibold hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors duration-200">
              {tag}
            </span>
          </a>
        ))}
      </div>
      <time class="text-neutral-600 dark:text-neutral-100 text-sm" datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
    </div>
  </div>

  <div class="flex flex-col py-8">
    <p class="italic text-sm sm:text-base max-w-xl mx-auto text-center text-neutral-800 dark:text-neutral-300">
      {description}
    </p>
  </div>
</header>
