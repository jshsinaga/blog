---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PostCard from '@/components/PostCard.astro';
import { blogsPage } from '@/data';
import { postUrl } from '@/utils/helper';

const posts = (await getCollection('blogs', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog Archive" description="Browse all blog posts by category or search through the complete archive of articles.">
  <div class="container max-w-5xl mx-auto text-neutral-600 dark:text-neutral-400 px-4 sm:px-6 lg:px-8">
    <Hero />

    <section class="pt-6 pb-6 sm:pt-8">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-black dark:text-neutral-100">{blogsPage.title}</h2>
      <p class="mt-4 max-w-2xl text-neutral-700 dark:text-neutral-300">{blogsPage.description}</p>
    </section>

    <div class="px-0 max-md:mt-4">
      <label class="sr-only" for="search-posts">Search posts</label>
      <input id="search-posts" placeholder="Search" class="w-full rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 px-4 py-3 text-neutral-900 dark:text-neutral-100" />
    </div>

    <section class="mt-6">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">Filter by Category:</h2>
        <button id="clear-filters" type="button" class="rounded bg-neutral-100 dark:bg-neutral-800 px-3 py-1 text-sm hover:bg-neutral-200 dark:hover:bg-neutral-700">Clear All</button>
        <a href="/tags" class="ml-auto text-sm font-medium text-neutral-800 underline underline-offset-4 transition-colors hover:text-neutral-950 dark:text-neutral-200 dark:hover:text-white">Browse all tags</a>
      </div>

      <div class="flex flex-wrap gap-2" id="category-buttons">
        <button type="button" data-category="" class="category-button rounded px-3 py-1 text-sm bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900">
          All Posts ({posts.length})
        </button>
        {categories.map((category) => (
          <button type="button" data-category={category.toLowerCase()} class="category-button rounded px-3 py-1 text-sm bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-100">
            {category} ({posts.filter((post) => post.data.tags.includes(category)).length})
          </button>
        ))}
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 sm:gap-6 mt-6" id="posts-list">
      {posts.map((post) => (
        <div
          class="post-card"
          data-title={post.data.title.toLowerCase()}
          data-description={post.data.description.toLowerCase()}
          data-tags={post.data.tags.join(' ').toLowerCase()}
        >
          <PostCard
            href={postUrl(post.id)}
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            image={post.data.image}
            alt={post.data.alt}
            tags={post.data.tags}
          />
        </div>
      ))}
    </section>

    <p id="empty-state" class="hidden py-10 text-center text-neutral-600 dark:text-neutral-300">No posts found.</p>

    <nav class="flex justify-center items-center mt-8 gap-2" aria-label="Pagination">
      <button id="prev-page" class="rounded border border-neutral-300 dark:border-neutral-700 px-3 py-2 disabled:opacity-50">Prev</button>
      <span id="page-status" class="text-sm text-neutral-700 dark:text-neutral-300"></span>
      <button id="next-page" class="rounded border border-neutral-300 dark:border-neutral-700 px-3 py-2 disabled:opacity-50">Next</button>
    </nav>
  </div>

  <script>
    const postsPerPage = 5;
    let pageNumber = 1;
    let selectedCategory = new URLSearchParams(window.location.search).get('category') || '';
    selectedCategory = selectedCategory.toLowerCase();

    const searchInput = document.getElementById('search-posts') as HTMLInputElement;
    const clearButton = document.getElementById('clear-filters') as HTMLButtonElement;
    const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-button'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
    const emptyState = document.getElementById('empty-state') as HTMLElement;
    const pageStatus = document.getElementById('page-status') as HTMLElement;
    const prevButton = document.getElementById('prev-page') as HTMLButtonElement;
    const nextButton = document.getElementById('next-page') as HTMLButtonElement;

    const setButtonState = () => {
      categoryButtons.forEach((button) => {
        const active = button.dataset.category === selectedCategory;
        button.classList.toggle('bg-neutral-900', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('dark:bg-neutral-100', active);
        button.classList.toggle('dark:text-neutral-900', active);
        button.classList.toggle('bg-neutral-100', !active);
        button.classList.toggle('dark:bg-neutral-800', !active);
      });
    };

    const getFilteredCards = (): HTMLElement[] => {
      const query = searchInput.value.trim().toLowerCase();
      return cards.filter((card) => {
        const tags = card.dataset.tags ?? '';
        const haystack = `${card.dataset.title ?? ''} ${card.dataset.description ?? ''} ${tags}`;
        const categoryMatch = !selectedCategory || tags.split(' ').includes(selectedCategory);
        const searchMatch = !query || haystack.includes(query);
        return categoryMatch && searchMatch;
      });
    };

    const update = () => {
      const filteredCards = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / postsPerPage));
      pageNumber = Math.min(pageNumber, totalPages);
      const start = (pageNumber - 1) * postsPerPage;
      const visibleCards = new Set(filteredCards.slice(start, start + postsPerPage));

      cards.forEach((card) => card.classList.toggle('hidden', !visibleCards.has(card)));
      emptyState.classList.toggle('hidden', filteredCards.length !== 0);
      pageStatus.textContent = `Page ${pageNumber} of ${totalPages}`;
      prevButton.disabled = pageNumber <= 1;
      nextButton.disabled = pageNumber >= totalPages;
      setButtonState();
    };

    searchInput.addEventListener('input', () => { pageNumber = 1; update(); });
    clearButton.addEventListener('click', () => {
      selectedCategory = '';
      searchInput.value = '';
      pageNumber = 1;
      history.replaceState(null, '', '/blogs');
      update();
    });
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedCategory = button.dataset.category || '';
        pageNumber = 1;
        const url = selectedCategory ? `/blogs?category=${encodeURIComponent(selectedCategory)}` : '/blogs';
        history.replaceState(null, '', url);
        update();
      });
    });
    prevButton.addEventListener('click', () => { if (pageNumber > 1) { pageNumber -= 1; update(); } });
    nextButton.addEventListener('click', () => { pageNumber += 1; update(); });

    update();
  </script>
</BaseLayout>
