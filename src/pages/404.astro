---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Page not found">
  <main class="container grid place-content-center max-w-3xl min-h-[60vh] mx-auto text-center">
    <div class="text-8xl font-bold text-neutral-300 mb-8 select-none">404</div>
    <p class="text-lg text-neutral-600 dark:text-neutral-300">Is this a 404 or a feature in beta?</p>
    <p class="text-lg text-neutral-800 dark:text-neutral-100 font-medium mt-2">Yes.</p>
  </main>
</BaseLayout>
