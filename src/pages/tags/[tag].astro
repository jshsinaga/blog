---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { postUrl, tagSlug } from '@/utils/helper';

export async function getStaticPaths() {
  const posts = await getCollection('blogs', ({ data }) => data.published);
  const tagMap = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      const entry = tagMap.get(slug);
      if (entry) {
        entry.posts.push(post);
      } else {
        tagMap.set(slug, { name: tag, posts: [post] });
      }
    }
  }

  return [...tagMap.entries()].map(([slug, entry]) => ({
    params: { tag: slug },
    props: { tag: entry.name, posts: entry.posts },
  }));
}

const { tag, posts } = Astro.props;
const sortedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`${tag} posts`} description={`All blog posts tagged with ${tag}.`}>
  <main class="container max-w-5xl mx-auto text-neutral-600 dark:text-neutral-400 px-4 sm:px-6 lg:px-8">
    <section class="py-12 sm:py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Tag</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-black dark:text-neutral-100">#{tag}</h1>
      <p class="mt-3 text-neutral-700 dark:text-neutral-300">{sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''} tagged with {tag}</p>
      <a href="/tags" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-neutral-800 underline underline-offset-4 transition-colors hover:text-neutral-950 dark:text-neutral-200 dark:hover:text-white">
        <span aria-hidden="true">&larr;</span> All tags
      </a>
    </section>

    <section class="grid grid-cols-1 gap-4 sm:gap-6">
      {sortedPosts.map((post) => (
        <PostCard
          href={postUrl(post.id)}
          title={post.data.title}
          date={post.data.date}
          description={post.data.description}
          image={post.data.image}
          alt={post.data.alt}
          tags={post.data.tags}
        />
      ))}
    </section>
  </main>
</BaseLayout>
