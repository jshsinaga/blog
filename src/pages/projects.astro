---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Projects"
  description="Web, mobile, AI, IoT, and software projects built or contributed to by Joshua Palti Sinaga."
  image="/portfolio-og.webp"
>
  <main>
    <section class="border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-neutral-600 dark:text-neutral-400">Project archive</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-bold tracking-[-0.045em] text-neutral-950 dark:text-white sm:text-7xl">Things I’ve built and helped bring to life.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">A growing archive of products, experiments, community work, and learning projects across the web, mobile, desktop, and embedded systems.</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <ProjectGallery projects={projects} headingLevel="h2" />
    </section>
  </main>
</BaseLayout>
