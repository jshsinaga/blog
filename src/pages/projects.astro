---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Projects"
  description="Web, mobile, AI, IoT, and software projects built or contributed to by Joshua Palti Sinaga."
  image="/portfolio-og.webp"
>
  <main>
    <section class="border-b border-neutral-200 dark:border-neutral-800">
      <div class="editorial-shell editorial-intro">
        <h1 class="editorial-title max-w-4xl">Things I’ve built and helped bring to life.</h1>
        <p class="editorial-description">A growing archive of products, experiments, community work, and learning projects across the web, mobile, desktop, and embedded systems.</p>
      </div>
    </section>

    <section class="editorial-shell pt-12 sm:pt-16">
      <ProjectGallery projects={projects} headingLevel="h2" editorial />
    </section>
  </main>
</BaseLayout>
