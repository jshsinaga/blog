---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CodeBlockEnhancer from '@/components/CodeBlockEnhancer.astro';
import ImageZoom from '@/components/ImageZoom.astro';
import { seoData, socialLinks } from '@/data';
import '@/styles/global.css';
import 'lenis/dist/lenis.css';

type JsonLd = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: JsonLd | JsonLd[];
}

const {
  title = seoData.title,
  description = seoData.description,
  image = seoData.image,
  canonical = new URL(Astro.url.pathname, seoData.mySite).toString(),
  ogType = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
} = Astro.props;

const pageTitle = title === seoData.title ? title : `${title} | ${seoData.siteName}`;
const imageUrl = new URL(image, seoData.mySite).toString();
const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: seoData.siteName,
    url: seoData.mySite,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: seoData.author,
    url: socialLinks.portfolioLink,
    sameAs: [socialLinks.githubLink, socialLinks.linkedinLink, socialLinks.twitterLink, socialLinks.instagramLink],
  },
];
const structuredData = [...baseStructuredData, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : prefersDark);
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={seoData.siteName} href={new URL('/rss.xml', seoData.mySite).toString()} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <meta property="og:site_name" content={seoData.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content={seoData.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:site" content={seoData.twitterHandle} />
    <meta name="twitter:creator" content={seoData.twitterHandle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {structuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class:list={['font-sans min-h-screen flex flex-col', { 'portfolio-page': Astro.url.pathname === '/' }]}>
    <Header />
    <CodeBlockEnhancer />
    <ImageZoom />

    <script>
      import Lenis from 'lenis';

      new Lenis({
        autoRaf: true,
        anchors: true,
        respectReducedMotion: true,
      });
    </script>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
